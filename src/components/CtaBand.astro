---
import Icon from './Icon.astro';
import { site } from '../lib/content';
import { useTranslations, route, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="cta">
  <div class="container inner" data-reveal>
    <div>
      <h2>{t('cta.title')}</h2>
      <p>{t('cta.text')}</p>
    </div>
    <div class="buttons">
      <a class="btn btn--light" href={route(lang, 'contact')}>
        {t('cta.button')}
        <Icon name="arrow" />
      </a>
      {
        site.phone && (
          <a class="btn btn--ghost-light" href={`tel:${site.phone}`}>
            <Icon name="phone" />
            {site.phoneDisplay || site.phone}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(198, 211, 227, 0.18), transparent 55%),
      var(--navy);
    color: #dfe4f2;
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .inner {
    display: grid;
    gap: 2.5rem;
    align-items: end;
  }
  @media (min-width: 960px) {
    .inner {
      grid-template-columns: 1.4fr 1fr;
    }
    .buttons {
      justify-content: flex-end;
    }
  }
  h2 {
    color: #fff;
    max-width: 18ch;
  }
  p {
    max-width: 52ch;
    margin: 0;
    font-size: 1.1rem;
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
