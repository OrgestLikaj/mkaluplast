---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/content';
import { defaultLang, ogLocales, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  image?: string;
  /** Other-language URLs of this page, used for hreflang + the language switcher. */
  alternates?: Partial<Record<Lang, string>>;
  /** Transparent header over a full-bleed hero image. */
  overlayHeader?: boolean;
  noindex?: boolean;
}

const {
  lang,
  title,
  description = site.tagline,
  image = '/uploads/about-hero.webp',
  alternates = {},
  overlayHeader = false,
  noindex = false,
} = Astro.props;

// Same format as the old WordPress site: "PVC Windows – MK AluPlast".
const fullTitle = title.startsWith(site.name) ? title : `${title} – ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const allAlternates = { ...alternates, [lang]: Astro.url.pathname };
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || import.meta.env.PUBLIC_NOINDEX === 'true') && <meta name="robots" content="noindex" />}
    {
      Object.entries(allAlternates).map(([l, href]) => (
        <link rel="alternate" hreflang={l} href={new URL(href!, Astro.site)} />
      ))
    }
    {
      allAlternates[defaultLang] && (
        <link rel="alternate" hreflang="x-default" href={new URL(allAlternates[defaultLang]!, Astro.site)} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#273272" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/wp-sitemap.xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <Header lang={lang} alternates={allAlternates} overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Fade sections in as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
