---
import PostView from '../../../views/PostView.astro';
import { getPosts, splitId } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts('it');
  return posts.map((post) => ({ params: { slug: splitId(post.id).slug }, props: { post } }));
}

const { post } = Astro.props;
---

<PostView lang="it" post={post} />
