---
import ProductView from '../../views/ProductView.astro';
import { getProducts, splitId } from '../../lib/content';

export async function getStaticPaths() {
  const products = await getProducts('sq');
  return products.map((product) => ({ params: { product: splitId(product.id).slug }, props: { product } }));
}

const { product } = Astro.props;
---

<ProductView lang="sq" product={product} />
