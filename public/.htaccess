# MK AluPlast — Apache config for Namecheap shared hosting

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and strip www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Never serve PHP helper includes directly
  RewriteRule (^|/)_[^/]*\.php$ - [F,L]

  # ---- Old WordPress URLs ----
  # Pages, products, /category/blog/ and /YYYY/MM/DD/<slug>/ articles keep their
  # exact old URLs, so they need no redirect. Only pages that were not rebuilt move:
  RewriteRule ^careers/?$ /contact-us/ [R=301,L]
  RewriteRule ^it/carriere/?$ /it/contattaci/ [R=301,L]
  RewriteRule ^author/ /category/blog/ [R=301,L]
  RewriteRule ^(it/)?feed/?$ /$1category/blog/ [R=301,L]
  RewriteRule ^it/2026/05/21/3047/?$ /it/category/blog/ [R=301,L]

  # Old WordPress system URLs are gone for good
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php) - [G,L]
  RewriteRule ^(it/)?wp-sitemap-users-1\.xml$ - [G,L]
  RewriteRule ^ndiqni-raportimin-tuaj/?$ - [G,L]

  # Add trailing slash to directory-style URLs (Astro builds /page/index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>

# ---- Caching: hashed build assets forever, HTML always fresh ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  # Astro emits content-hashed filenames like index.Bx3k2Lq9.css
  <FilesMatch "\.[A-Za-z0-9_-]{8,}\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
